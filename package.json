    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "prettier": "3.9.6",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "health-api",
  "version": "1.0.0",
  "description": "Production-hardened HTTP/HTTPS service monitoring with a web dashboard and PostgreSQL.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "ci": "npm run lint && npm test"

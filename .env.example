# Required for docker compose production deployment
DB_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Set true only when the app is behind a trusted reverse proxy.
TRUST_PROXY=false

# Monitoring defaults
DEFAULT_CHECK_INTERVAL_SECONDS=60
DEFAULT_CHECK_TIMEOUT_MS=10000
MONITOR_CONCURRENCY=5
RESULT_RETENTION_DAYS=30

# SSRF policy: public targets are allowed by default.
# To monitor selected private/internal hostnames, allowlist them explicitly.
# Wildcards are supported only as a leading subdomain pattern.
# Example: TARGET_ALLOWLIST=api.internal.example,*.svc.example
TARGET_ALLOWLIST=
ALLOW_PRIVATE_TARGETS=false

# Optional generic incident webhook (Slack/Teams automation endpoint or internal receiver)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=
ALERT_WEBHOOK_TIMEOUT_MS=5000
